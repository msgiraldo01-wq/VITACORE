# Dominio publico real de la app (SIN slash al final), para armar el
# enlace de confirmar/cancelar que va en los correos al paciente. En
# produccion SIEMPRE debe quedar configurado (si se deja vacio, se usa
# el host con el que el navegador llego a la app -- localhost o una IP
# interna no le sirven de nada a un paciente real).
APP_BASE_URL=https://vitacore.cloud
